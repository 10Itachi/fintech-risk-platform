# .env.example

# =====================================================
# SERVER
# =====================================================
SERVER_PORT=8084

# =====================================================
# SPRING APPLICATION
# =====================================================
SPRING_APPLICATION_NAME=transaction-observability-service

# =====================================================
# MYSQL DATABASE
# =====================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=your_database_name
MYSQL_USERNAME=your_mysql_username
MYSQL_PASSWORD=your_mysql_password

# =====================================================
# HIKARI
# =====================================================
HIKARI_MAXIMUM_POOL_SIZE=10

# =====================================================
# JPA / HIBERNATE
# =====================================================
HIBERNATE_DDL_AUTO=update
HIBERNATE_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=true
HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect

# =====================================================
# KEYCLOAK / JWT
# =====================================================
KEYCLOAK_JWK_SET_URI=http://localhost:8080/realms/your-realm/protocol/openid-connect/certs

# =====================================================
# KAFKA
# =====================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:19092,localhost:19094,localhost:19096

KAFKA_TRANSACTION_FINALIZED_TOPIC=transaction.finalized.v1
KAFKA_TRANSACTION_FINALIZED_DLT_TOPIC=transaction.finalized.v1-dlt

KAFKA_CONSUMER_GROUP=transaction-observability-event
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_MAX_POLL_RECORDS=20
KAFKA_MAX_POLL_INTERVAL_MS=10000

KAFKA_LISTENER_CONCURRENCY=3
KAFKA_ACK_MODE=MANUAL

# =====================================================
# LOGGING
# =====================================================
LOGGING_LEVEL_COM_GRINGOTTS=INFO

LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_BOOT=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=WARN
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=WARN

LOGGING_LEVEL_ORG_HIBERNATE_SQL=WARN
LOGGING_LEVEL_ORG_HIBERNATE_BIND=WARN
LOGGING_LEVEL_ORG_HIBERNATE_POOLING=WARN

LOGGING_LEVEL_KAFKA_CONSUMER_CONFIG=WARN
LOGGING_LEVEL_KAFKA_METADATA=WARN
LOGGING_LEVEL_KAFKA_NETWORK_CLIENT=ERROR
LOGGING_LEVEL_KAFKA_CONSUMER_COORDINATOR=WARN
LOGGING_LEVEL_KAFKA_CONSUMER_UTILS=WARN
LOGGING_LEVEL_KAFKA_REBALANCE=WARN

LOGGING_LEVEL_SPRING_KAFKA=WARN

LOGGING_LEVEL_APACHE_CATALINA=INFO
LOGGING_LEVEL_HIKARI=INFO