# =========================
# USER SERVICE CONFIG
# =========================

# Server
USER_SERVICE_PORT=8081

# =========================
# DATABASE CONFIG
# =========================
USER_DB_URL=jdbc:mysql://localhost:3306/gbank_user_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
USER_DB_USERNAME=root
USER_DB_PASSWORD=your-db-password

# =========================
# JPA CONFIG
# =========================
USER_DDL_AUTO=update
USER_SHOW_SQL=true

# =========================
# SECURITY (JWT / KEYCLOAK)
# =========================
USER_ISSUER_URI=http://localhost:8080/realms/gringotts

# =========================
# KEYCLOAK ADMIN CONFIG
# =========================
USER_KEYCLOAK_SERVER_URL=http://localhost:8080
USER_KEYCLOAK_REALM=gringotts
USER_KEYCLOAK_CLIENT_ID=user-service
USER_KEYCLOAK_CLIENT_SECRET=your-client-secret

# =========================
# ACTUATOR
# =========================
USER_ACTUATOR_ENDPOINTS=health,metrics,prometheus

# =========================
# RESILIENCE4J - RETRY
# =========================
USER_RETRY_ATTEMPTS=3
USER_RETRY_WAIT=500ms
USER_RETRY_BACKOFF=2

# =========================
# RESILIENCE4J - CIRCUIT BREAKER
# =========================
USER_CB_WINDOW=10
USER_CB_FAILURE_RATE=50
USER_CB_WAIT=10s

# =========================
# REDIS CONFIG
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379