# SERVER
SERVER_PORT=8082

# SPRING
SPRING_APPLICATION_NAME=risk-decision-service

# DATABASE
DB_URL=jdbc:mysql://localhost:3306/your_db
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_DRIVER=com.mysql.cj.jdbc.Driver

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect

# SECURITY
JWT_ISSUER_URI=http://localhost:8080/realms/your-realm

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379

# CACHE
CACHE_TTL=600000

# RISK POLICY
RISK_POLICY_VERSION=2026-01-30
RISK_POLICY_ACTIVATED_AT=2026-01-30T00:00:00Z

MAX_SINGLE_AMOUNT=50000
MAX_DAILY_AMOUNT=100000
CARD_WITHDRAWAL_LIMIT=50000

DECLINE_THRESHOLD=0.70
REVIEW_THRESHOLD=0.40

# SOFT RULES
SOFT_HIGH_AMOUNT=7000
SOFT_MEDIUM_AMOUNT=5000
VELOCITY_HIGH=20
VELOCITY_MEDIUM=10
CARD_HIGH_AMOUNT=6000

DELTA_LOW=0.05
DELTA_MEDIUM=0.10
DELTA_HIGH=0.15
DELTA_CRITICAL=0.20

# LOGGING
LOG_PATTERN=%d [%X{correlationId}] %-5level %logger - %msg%n